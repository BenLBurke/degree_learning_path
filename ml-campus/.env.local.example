DATABASE_URL="file:./dev.db"
NEXTAUTH_SECRET="your-secret-here-change-in-production"
NEXTAUTH_URL="http://localhost:3000"

# LLM backend.
# Option A: set a real Anthropic API key (works in dev and prod).
ANTHROPIC_API_KEY="your-anthropic-api-key-here"
# Option B (LOCAL DEV ONLY): leave the key blank/placeholder and set this to
# route model calls through the `claude` CLI you're already logged into via
# Claude Code — no API key needed. Requires `claude` on PATH.
# LLM_BACKEND="claude-cli"

NEXT_PUBLIC_ENABLE_COPILOT_SIDECAR="false"

# Comma-separated emails granted professor/admin access to /admin without
# editing the database. Leave blank to rely solely on the stored `role` field.
ADMIN_EMAILS=""
